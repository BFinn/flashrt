+struct ggml_tensor * ggml_get_rows_as(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        enum ggml_type        type) {
+    GGML_ASSERT(type == GGML_TYPE_F32 || type == GGML_TYPE_F16);
+    struct ggml_tensor * result = ggml_get_rows(ctx, a, b);
+    if (type != result->type) {
